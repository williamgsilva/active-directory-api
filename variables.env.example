# Produção (Swarm): copie para variables.env ao lado do docker-project.yml, no manager.
# Alterou? rode ./start.sh de novo.
# Substitua todos os valores <...>.
LOG_LEVEL=INFO

# Chave Fernet. OBRIGATÓRIA: criptografa a chave JWT guardada no banco.
# AD_PASSWORD e DATABASE_PASSWORD devem estar criptografadas com ela: ./admin.sh encrypt
# Não troque depois de criada: a chave JWT no banco deixaria de abrir.
APP_MASTER_KEY=<chave-fernet-gerada-pelo-admin.sh-encrypt>

# --- Active Directory ---
AD_SSL=false
AD_SERVER=<ip-ou-hostname-do-controlador-de-dominio>
# AD_PORT=          # padrão: 636 com SSL, 389 sem SSL
AD_DOMAIN=<dominio.local>
AD_BASE_DOMAIN=<DC=dominio,DC=local>
# Com AD_SSL=true a CA do AD precisa estar na imagem ou num docker config; vazio = sem validação
AD_CERTS=
AD_CONNECT_TIMEOUT=5
AD_RECEIVE_TIMEOUT=10
AD_NESTED_GROUPS=false

# Conta de serviço (readiness, login por e-mail e consultas /users e /groups)
AD_USER=<conta-de-servico>
AD_PASSWORD=<senha-criptografada-com-APP_MASTER_KEY>

# --- JWT (a chave de assinatura é criada e guardada no banco automaticamente) ---
JWT_ISSUER=active-directory-api
JWT_EXPIRES_MINUTES=480

# --- Banco: aplicações clientes e chaves JWT ---
DATABASE_HOST=<host-do-postgres>
DATABASE_PORT=5432
DATABASE_NAME=<nome-do-banco>
DATABASE_SCHEMA=active_directory_api
DATABASE_USER=<usuario-do-banco>
DATABASE_PASSWORD=<senha-criptografada-com-APP_MASTER_KEY>
DATABASE_SHOW_SQL=false
