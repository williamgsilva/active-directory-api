# Desenvolvimento local: copie para config/app.env (usado pelo docker-compose.local.yml e pelo uvicorn local).
# Substitua todos os valores <...>.
LOG_LEVEL=INFO

# Chave Fernet. Gerar: python -m app.cli encrypt (deixe a chave em branco para gerar uma nova)
APP_MASTER_KEY=<chave-fernet>

# --- Active Directory ---
AD_SSL=false
AD_SERVER=<ip-ou-hostname-do-controlador-de-dominio>
# AD_PORT=          # padrão: 636 com SSL, 389 sem SSL
AD_DOMAIN=<dominio.local>
AD_BASE_DOMAIN=<DC=dominio,DC=local>
AD_CERTS=
AD_CONNECT_TIMEOUT=5
AD_RECEIVE_TIMEOUT=10
AD_NESTED_GROUPS=false

# Conta de serviço (readiness, login por e-mail e consultas /users e /groups)
AD_USER=<conta-de-servico>
AD_PASSWORD=<senha-criptografada-com-APP_MASTER_KEY>

# --- JWT (a chave de assinatura é criada e guardada no banco automaticamente) ---
JWT_ISSUER=active-directory-api
JWT_EXPIRES_MINUTES=480

# --- Banco ---
# No docker-compose.local.yml o DATABASE_URL já aponta para o Postgres do compose.
# Rodando a API fora do Docker (uvicorn local), use o Postgres do compose em localhost:15432:
DATABASE_HOST=localhost
DATABASE_PORT=15432
DATABASE_NAME=active_directory_api
DATABASE_SCHEMA=active_directory_api
DATABASE_USER=active_directory_api
# Criptografe com a APP_MASTER_KEY (python -m app.cli encrypt). Senha do Postgres local: POSTGRES_PASSWORD do compose
DATABASE_PASSWORD=<senha-criptografada-com-APP_MASTER_KEY>
